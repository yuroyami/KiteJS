+/* KiteJS: drop every pending job without running it */
+void JS_KiteDiscardPendingJobs(JSRuntime *rt)
+{
+    struct list_head *el, *el1;
+    int i;
+
+    list_for_each_safe(el, el1, &rt->job_list) {
+        JSJobEntry *e = list_entry(el, JSJobEntry, link);
+        list_del(&e->link);
+        for(i = 0; i < e->argc; i++)
+            JS_FreeValueRT(rt, e->argv[i]);
+        js_free_rt(rt, e);
+    }
+}
+
+/* KiteJS: the clock and the time zone Date reads */
+void JS_KiteSetDateHooks(JSRuntime *rt, JSKiteNowFunc *now,
+                         JSKiteTimezoneOffsetFunc *tz_offset)
+{
+    rt->kite_now = now;
+    rt->kite_tz_offset = tz_offset;
+}
